# Modèle de configuration : copier en .env et compléter. Aucun secret ici.
# Le fichier .env est lu par Next.js et par la CLI Prisma (prisma.config.ts).
# Les variables commentées sont facultatives : leur valeur par défaut est indiquée.

# URL publique du site (SEO, liens absolus)
SITE_URL=http://localhost:3000

# Base MariaDB applicative (instance locale existante, compte dédié)
DATABASE_URL=mysql://portfolio_v2:CHANGE_ME@127.0.0.1:3310/portfolio_v2

# Base shadow, utilisée uniquement par `prisma migrate dev` qui la vide à chaque exécution
# (inutile pour `prisma migrate deploy` et à l'exécution).
# Doit être distincte de DATABASE_URL et se terminer par _shadow (vérifié par prisma.config.ts).
SHADOW_DATABASE_URL=mysql://portfolio_v2:CHANGE_ME@127.0.0.1:3310/portfolio_v2_shadow

# Authentification (Auth.js) : secret de signature des sessions, 32 octets aléatoires
# au minimum, propre à chaque environnement (ex. : npx auth secret --raw).
AUTH_SECRET=
# true uniquement en local ou derrière le reverse proxy de confiance (production).
AUTH_TRUST_HOST=true

# Stockage des médias importés depuis l'administration (hors base, non versionné)
# MEDIA_ROOT=./storage/media

# Formulaire de contact (Resend). Clé vide : formulaire indisponible, aucun envoi.
# Clé d'API Resend propre à ce projet, permission « Sending Access » uniquement.
# Secret : jamais versionné, jamais exposé au navigateur.
RESEND_API_KEY=
# Expéditeur sur le domaine vérifié chez Resend (le destinataire est l'adresse
# de contact réglée dans l'administration ; le visiteur est en Reply-To).
CONTACT_FROM="Portfolio Corentin Lanaud <contact@corentin-lanaud-portfolio.fr>"
# Durée de conservation des messages reçus, en jours (365 par défaut, 1 à 3650).
# Au-delà, ils sont supprimés définitivement.
# CONTACT_RETENTION_DAYS=365
# Dossier des compteurs anti-abus persistants (volume Docker en production).
# STATE_DIR=./storage/state
