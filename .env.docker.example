# Modèle de configuration du conteneur Docker local : copier en .env.docker et compléter.
# Distinct du .env de développement. Jamais copié dans l'image (.dockerignore), jamais versionné.

# Adresse exacte utilisée dans le navigateur (cookies, canoniques, redirections Auth.js).
# 127.0.0.1 plutôt que localhost : les cookies ne se mélangent pas avec `npm run dev` (localhost:3000).
SITE_URL=http://127.0.0.1:3200
AUTH_URL=http://127.0.0.1:3200

# Base MariaDB existante, jointe par son port publié sur l'hôte (MariaDB n'est pas gérée par compose.yaml).
# Délais courts : base injoignable → erreur en ~5 s au lieu de 10 à 30 s.
DATABASE_URL=mysql://portfolio_v2:CHANGE_ME@host.docker.internal:3310/portfolio_v2?connectTimeout=3000&acquireTimeout=5000

# Secret de session propre à cet environnement (npx auth secret --raw).
AUTH_SECRET=
# Local : port publié sur 127.0.0.1 uniquement. Futur VPS : derrière le reverse proxy seulement.
AUTH_TRUST_HOST=true

# Resend (vide = formulaire indisponible, aucun envoi).
RESEND_API_KEY=
CONTACT_FROM="Portfolio Corentin Lanaud <contact@corentin-lanaud-portfolio.fr>"
# CONTACT_RETENTION_DAYS=365

# MEDIA_ROOT=/data/media et STATE_DIR=/data/state sont fixés par l'image.
